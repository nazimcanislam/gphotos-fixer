---
import { Picture } from "astro:assets";
import logoImage from "../assets/logo.png";
---

<style>
  footer {
    background-color: var(--bg);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    justify-content: space-between;
    align-items: start;
    column-gap: 48px;
    row-gap: 24px;
    padding: 48px 16px;
    max-width: 1024px;
    width: 100%;
    margin-inline: auto;
  }

  .footer-brand,
  .footer-brand img {
    display: block;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: start;
    gap: 8px;
    text-decoration: none;
  }

  .footer-brand span {
    font-family: var(--mono);
    font-size: clamp(0.8125rem, 2.5vw, 1rem);
    color: var(--fg);
  }

  .footer-nav {
    display: grid;
    list-style-type: none;
    gap: 16px;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--fg-muted);
    font-family: var(--mono);
    font-size: clamp(0.8125rem, 2.5vw, 1rem);
  }

  .footer-nav a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .footer-div h3 {
    font-size: 1rem;
    font-family: var(--mono);
    color: var(--accent);
  }

  .footer-div p {
    color: var(--fg-muted);
  }

  .footer-copyright {
    text-align: center;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    font-size: 1rem;
    font-family: var(--mono);
    color: var(--fg-muted);
  }
</style>

<footer>
  <div class="footer-inner">
    <div class="footer-div">
      <a href="." class="footer-brand">
        <Picture
          src={logoImage}
          formats={["avif", "webp"]}
          alt="Brand Image"
          width={32}
          height={32}
          loading={"lazy"}
        />
        <span>gphotos<span style="color: var(--accent);">-fixer</span></span>
      </a>
      <p>
        Rescue your Google Photos Takeout export. Handles every broken JSON
        naming variant, Windows path limit, and timestamp corruption others
        miss.
      </p>
    </div>

    <div class="footer-div">
      <h3>Section</h3>
      <ul class="footer-nav">
        <li>
          <a href="#problem">Problem</a>
        </li>
        <li>
          <a href="#features">Features</a>
        </li>
        <li>
          <a href="#usage">Usage</a>
        </li>
      </ul>
    </div>

    <div class="footer-div">
      <h3>Links</h3>
      <ul class="footer-nav">
        <li>
          <a href="#problem">GitHub Repo ↗</a>
        </li>
        <li>
          <a href="#features">Open issue ↗</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-copyright">
    © {new Date().getFullYear()} Nazımcan İslam • Built with Astro and ❤️
  </div>
</footer>
