<style>
  .problem-wrapper {
    background-color: var(--bg-card);
  }

  .problem-real-test-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .test {
    background: var(--bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 16px;
  }

  .test-emoji,
  .test-number,
  .test-text {
    display: block;
    text-align: center;
    font-family: var(--mono);
  }

  .test-emoji {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .test-text {
    font-size: 1rem;
    color: var(--fg-muted);
  }

